# ──────────────────────────────────────────────
# happy-work environment variables
# Copy to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Server
PORT=8080

# Jira
# Optional: HMAC secret configured in Jira webhook settings for payload verification.
JIRA_WEBHOOK_SECRET=

# The transition status name that triggers Gemini (default: "In Progress").
JIRA_TRIGGER_STATUS='In Progress'

# Google Gemini
# Generate at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# See available models at: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.0-flash

# Bitbucket
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=your-workspace-slug
# Generate at: Bitbucket → Repository settings → Access tokens (or Workspace settings → Access tokens)
BITBUCKET_API_KEY=your-api-key

# Optional: override the repo slug derived from the Jira project key.
# BITBUCKET_REPO_SLUG=my-repo
